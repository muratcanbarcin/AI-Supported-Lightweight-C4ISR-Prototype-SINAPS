# =============================================================================
# C4ISR AI Microservice Environment Configuration
# =============================================================================

# Application
APP_NAME=C4ISR AI Microservice
APP_VERSION=1.0.0
DEBUG=true

# Database - Local Development
DATABASE_URL=postgresql://admin:password@localhost:5432/c4isr_db

# Database - Docker Network
DATABASE_URL_DOCKER=postgresql://admin:password@c4isr-db:5432/c4isr_db

# Model Configuration
MODEL_NAME=google/gemma-2-2b-it
EMBEDDING_MODEL=all-MiniLM-L6-v2

# HuggingFace Token (Required for Gemma model access)
# Get your token from: https://huggingface.co/settings/tokens
# You must also accept the Gemma model license at: https://huggingface.co/google/gemma-2-2b-it
HF_TOKEN=your_huggingface_token_here

# LoRA Configuration
LORA_ADAPTER_PATH=./adapters
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.1

# Quantization
USE_4BIT_QUANTIZATION=true
BNB_4BIT_COMPUTE_DTYPE=float16
BNB_4BIT_QUANT_TYPE=nf4

# RAG Configuration
RAG_TOP_K=3
EMBEDDING_DIMENSION=384

# API
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Groq Chat Engine (Primary chat backend — replaces local Llama)
# =============================================================================
# Get a free API key at: https://console.groq.com/keys
# When GROQ_API_KEY is set and GROQ_ENABLED=true, /chat uses Groq's
# llama-3.3-70b-versatile. On failure, falls back to local Llama-3.1-8B
# (lazy-loaded on first fallback).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ENABLED=true
GROQ_TIMEOUT_S=30
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1024

# When true (default), local Llama is NOT loaded at startup, freeing VRAM
# for Gemma. Set to false to force-load Llama on startup as a hot standby.
CHAT_LOCAL_FALLBACK_LAZY=true
