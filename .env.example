# Copy to .env in the repository root, then export it before starting the backend:
#   set -a && source .env && set +a
#
# Docker Compose reads this file automatically.
# Replace every changeme value before sharing a deployment.
# JWT_SECRET must be at least 32 characters.

# PostgreSQL (docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=c4isr_db

# Backend (Spring Boot)
DB_URL=jdbc:postgresql://localhost:5433/c4isr_db
DB_USERNAME=admin
DB_PASSWORD=changeme
JWT_SECRET=changeme-replace-with-a-32-byte-secret
JWT_EXPIRATION_MS=86400000
SEED_DEFAULT_PASSWORD=changeme
SERVER_PORT=8080
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=c4isr-backend
AI_SERVICE_URL=http://127.0.0.1:8000
SIMULATION_TICK_INTERVAL_MS=15000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=changeme

# AI service (also copy the DATABASE_URL lines into ai-service/.env)
DATABASE_URL=postgresql://admin:changeme@localhost:5433/c4isr_db
DATABASE_URL_DOCKER=postgresql://admin:changeme@c4isr-db:5432/c4isr_db
HF_TOKEN=
GROQ_API_KEY=

# Optional MQTT credentials. The bundled Mosquitto broker allows anonymous clients.
MQTT_USER=
MQTT_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
