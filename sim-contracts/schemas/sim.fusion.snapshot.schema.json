{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sim Fusion Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tracks",
    "associations"
  ],
  "properties": {
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "track_id",
          "type",
          "state"
        ],
        "properties": {
          "track_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lat",
              "lon",
              "alt_m"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "alt_m": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "associations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "track_id",
          "detections"
        ],
        "properties": {
          "track_id": {
            "type": "string"
          },
          "detections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
