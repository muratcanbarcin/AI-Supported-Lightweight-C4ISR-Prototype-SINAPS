{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sim Sensor Detection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sensor_id",
    "detections"
  ],
  "properties": {
    "sensor_id": {
      "type": "string"
    },
    "noise_model": {
      "type": "string"
    },
    "detections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "det_id",
          "time",
          "type",
          "position",
          "confidence_pct"
        ],
        "properties": {
          "det_id": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "UAS",
              "GROUND",
              "VEHICLE",
              "UNKNOWN"
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "alt_m": {
                "type": "number"
              },
              "accuracy_m": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "velocity_mps": {
            "type": "number",
            "minimum": 0
          },
          "heading_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "confidence_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "truth_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
