{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sim Clock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "speed_factor",
    "frame",
    "sim_time"
  ],
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "INIT",
        "RUNNING",
        "PAUSED",
        "STOPPED"
      ]
    },
    "speed_factor": {
      "type": "number",
      "minimum": 0
    },
    "frame": {
      "type": "integer",
      "minimum": 0
    },
    "sim_time": {
      "type": "string",
      "format": "date-time"
    }
  }
}
