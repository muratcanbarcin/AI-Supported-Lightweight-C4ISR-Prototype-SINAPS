{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sim Evaluation Metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "window",
    "metrics"
  ],
  "properties": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_start",
        "frame_end"
      ],
      "properties": {
        "frame_start": {
          "type": "integer",
          "minimum": 0
        },
        "frame_end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "far": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency_ms_avg": {
          "type": "number",
          "minimum": 0
        },
        "track_purity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
