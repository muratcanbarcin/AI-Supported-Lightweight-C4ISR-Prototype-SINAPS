{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Watch Telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "soldier_id",
    "unit_id",
    "collected_at",
    "vitals",
    "device"
  ],
  "properties": {
    "soldier_id": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt_m": {
          "type": "number"
        }
      }
    },
    "vitals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hr_bpm"
      ],
      "properties": {
        "hr_bpm": {
          "type": "integer",
          "minimum": 20,
          "maximum": 240
        },
        "spo2_pct": {
          "type": "number",
          "minimum": 50,
          "maximum": 100
        },
        "resp_bpm": {
          "type": "number",
          "minimum": 4,
          "maximum": 60
        },
        "skin_temp_c": {
          "type": "number",
          "minimum": 20,
          "maximum": 45
        },
        "stress_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "model",
        "battery_pct"
      ],
      "properties": {
        "device_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "battery_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
