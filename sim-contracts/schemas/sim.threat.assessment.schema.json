{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sim Threat Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track_id",
    "classification",
    "risk_score"
  ],
  "properties": {
    "track_id": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "FRIEND",
        "NEUTRAL",
        "HOSTILE",
        "UNKNOWN"
      ]
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "intent": {
      "type": "string",
      "enum": [
        "RECON",
        "STRIKE",
        "JAM",
        "UNKNOWN"
      ]
    },
    "eta_to_perimeter_s": {
      "type": "number",
      "minimum": 0
    },
    "features": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
