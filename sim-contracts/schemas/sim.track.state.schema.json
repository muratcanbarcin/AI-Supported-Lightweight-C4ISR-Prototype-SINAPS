{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sim Track State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track_id",
    "state",
    "confidence_pct"
  ],
  "properties": {
    "track_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filter": {
      "type": "string"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon",
        "alt_m",
        "speed_mps",
        "heading_deg"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt_m": {
          "type": "number"
        },
        "speed_mps": {
          "type": "number",
          "minimum": 0
        },
        "heading_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        }
      }
    },
    "covariance": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "confidence_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
