{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sim Decision Recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "options"
  ],
  "properties": {
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "target",
          "score"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "explanation": {
      "type": "string"
    }
  }
}
