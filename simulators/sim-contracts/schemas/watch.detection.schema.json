{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Watch Detection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "soldier_id",
    "time",
    "kind",
    "score"
  ],
  "properties": {
    "soldier_id": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "HIGH_HEART_RATE",
        "LOW_SPO2",
        "FALL_DETECTED",
        "IMMOBILITY"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
