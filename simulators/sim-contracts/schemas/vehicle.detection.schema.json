{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vehicle Detection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sensor_id",
    "time",
    "kind",
    "position",
    "confidence_pct"
  ],
  "properties": {
    "sensor_id": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "OBSTACLE",
        "AMBUSH",
        "MINE",
        "HOSTILE_VEHICLE",
        "UNKNOWN"
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt_m": {
          "type": "number"
        }
      }
    },
    "confidence_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
