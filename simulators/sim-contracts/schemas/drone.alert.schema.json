{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Drone Alert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_id",
    "time",
    "severity",
    "title",
    "category",
    "related"
  ],
  "properties": {
    "alert_id": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "WARNING",
        "MAJOR",
        "CRITICAL"
      ]
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "C-UAS",
        "NAV",
        "POWER",
        "LINK"
      ]
    },
    "description": {
      "type": "string"
    },
    "related": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
