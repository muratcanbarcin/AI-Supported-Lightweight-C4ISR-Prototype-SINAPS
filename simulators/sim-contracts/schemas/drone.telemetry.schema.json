{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Drone Telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "time",
    "position",
    "ground_speed_mps",
    "mode",
    "battery"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt_m": {
          "type": "number"
        }
      }
    },
    "yaw_deg": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "pitch_deg": {
      "type": "number"
    },
    "roll_deg": {
      "type": "number"
    },
    "ground_speed_mps": {
      "type": "number",
      "minimum": 0
    },
    "vertical_speed_mps": {
      "type": "number"
    },
    "mode": {
      "type": "string",
      "enum": [
        "MANUAL",
        "AUTO",
        "RTL",
        "LOITER",
        "GUIDED",
        "HOLD"
      ]
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soc_pct"
      ],
      "properties": {
        "soc_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "voltage_v": {
          "type": "number"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rssi_dbm": {
          "type": "number"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
